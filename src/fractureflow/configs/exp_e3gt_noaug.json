{
  "seed": 42,
  "obs_frac": 0.4,
  "wd": 0.00005,
  "backbone": {
    "name": "e3gt_v4",
    "d_model": 256,
    "k_knn": 16,
    "n_layers": 4,
    "dropout": 0.1,
    "obs_drop": 0.25
  },
  "losses": [
    {"name": "dir", "w_hid": 1.0, "w_obs": 0.3, "w_aniso": 1.0, "aniso_floor": 0.2},
    {"name": "set_dir", "w_set": 0.5}
