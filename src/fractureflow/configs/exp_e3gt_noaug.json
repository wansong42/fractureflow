      "warmup": 500,
      "eval_every": 4000,
      "ckpt": "models/exp_e3gt_noaug_stageA.pt",
      "augments": []
    },
    "B": {
      "enabled": true,
      "from_stageA": true,
      "steps": 30000,
      "lr": 0.0001,
      "batch": 16,
      "warmup": 500,
      "eval_every": 2000,
      "ckpt": "models/exp_e3gt_noaug_final.pt",
      "augments": []
    }
  },
  "out_eval": "results/exp_e3gt_noaug_eval.json"
}
