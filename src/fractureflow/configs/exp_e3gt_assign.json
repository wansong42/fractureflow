{
  "seed": 42,
  "obs_frac": 0.4,
  "wd": 5e-5,
  "out_eval": "results/exp_e3gt_assign_eval.json",
  "backbone": {
    "name": "e3gt_assign",
    "d_model": 256, "k_knn": 16, "n_layers": 4, "dropout": 0.1,
    "obs_drop": 0.25, "K": 8
  },
  "augments": [
    {"name": "so3"},
    {"name": "domain_rand", "resample_frac": false}
  ],
  "losses": [
    {"name": "dir", "w_hid": 1.0, "w_obs": 0.3},
    {"name": "memb", "w_memb": 1.0},
    {"name": "set_dir", "w_set": 0.3}
  ],
  "stages": {
    "A": {
      "enabled": true, "steps": 40000, "lr": 3e-4, "batch": 32, "warmup": 500,
      "eval_every": 4000, "from_stageA": false, "ckpt": "models/exp_assign_stageA.pt",
      "augments": [
        {"name": "so3"},
        {"name": "domain_rand", "resample_frac": false}
      ]
    },
    "B": {
      "enabled": true, "steps": 30000, "lr": 1e-4, "batch": 16, "warmup": 500,
      "eval_every": 2000, "from_stageA": true, "ckpt": "models/exp_assign_final.pt",
      "augments": [
        {"name": "so3"},
        {"name": "domain_rand", "resample_frac": false}
      ]
    }
  }
}
